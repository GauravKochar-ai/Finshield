{
  "Comment": "finshield-incident (Standard). Input = Alert Raised detail {alert_id, severity, previous_severity, score, user_id, principal_arn, detected_at}.",
  "StartAt": "EvidenceAlertRaised",
  "States": {
    "EvidenceAlertRaised": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${EvidenceFnArn}",
        "Payload": {
          "action": "append",
          "alert_id.$": "$.alert_id",
          "type": "ALERT_RAISED",
          "actor": "incident",
          "execution.$": "$$.Execution.Name",
          "payload.$": "$"
        }
      },
      "ResultSelector": {
        "result.$": "$.Payload"
      },
      "ResultPath": null,
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error_alert_raised",
          "Next": "SetDeadlines"
        }
      ],
      "Next": "SetDeadlines"
    },
    "SetDeadlines": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${SetDeadlinesFnArn}",
        "Payload": {
          "alert_id.$": "$.alert_id",
          "detected_at.$": "$.detected_at",
          "execution.$": "$$.Execution.Name"
        }
      },
      "ResultSelector": {
        "result.$": "$.Payload"
      },
      "ResultPath": "$.deadlines",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error_deadlines",
          "Next": "BranchOnSeverity"
        }
      ],
      "Next": "BranchOnSeverity"
    },
    "BranchOnSeverity": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.severity",
          "StringEquals": "CRITICAL",
          "Next": "CriticalParallel"
        },
        {
          "Variable": "$.severity",
          "StringEquals": "HIGH",
          "Next": "HighNotify"
        }
      ],
      "Default": "MediumAiExplain"
    },
    "CriticalParallel": {
      "Type": "Parallel",
      "Comment": "Containment never waits for AI: each branch finishes on its own; status CONTAINED is set inside the containment branch.",
      "Branches": [
        {
          "StartAt": "RevokeSessions",
          "States": {
            "RevokeSessions": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke",
              "Parameters": {
                "FunctionName": "${RevokeFnArn}",
                "Payload": {
                  "alert_id.$": "$.alert_id",
                  "principal_arn.$": "$.principal_arn",
                  "user_id.$": "$.user_id",
                  "mode": "${ContainmentMode}",
                  "execution.$": "$$.Execution.Name"
                }
              },
              "ResultSelector": {
                "result.$": "$.Payload"
              },
              "ResultPath": "$.revoke_sessions",
              "Retry": [
                {
                  "ErrorEquals": [
                    "Lambda.ServiceException",
                    "Lambda.AWSLambdaException",
                    "Lambda.SdkClientException",
                    "Lambda.TooManyRequestsException"
                  ],
                  "IntervalSeconds": 1,
                  "MaxAttempts": 2,
                  "BackoffRate": 2
                }
              ],
              "Catch": [
                {
                  "ErrorEquals": [
                    "States.ALL"
                  ],
                  "ResultPath": "$.error_revoke_sessions",
                  "Next": "DeactivateKeys"
                }
              ],
              "Next": "DeactivateKeys"
            },
            "DeactivateKeys": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke",
              "Parameters": {
                "FunctionName": "${DeactivateFnArn}",
                "Payload": {
                  "alert_id.$": "$.alert_id",
                  "principal_arn.$": "$.principal_arn",
                  "user_id.$": "$.user_id",
                  "mode": "${ContainmentMode}",
                  "execution.$": "$$.Execution.Name"
                }
              },
              "ResultSelector": {
                "result.$": "$.Payload"
              },
              "ResultPath": "$.deactivate_keys",
              "Retry": [
                {
                  "ErrorEquals": [
                    "Lambda.ServiceException",
                    "Lambda.AWSLambdaException",
                    "Lambda.SdkClientException",
                    "Lambda.TooManyRequestsException"
                  ],
                  "IntervalSeconds": 1,
                  "MaxAttempts": 2,
                  "BackoffRate": 2
                }
              ],
              "Catch": [
                {
                  "ErrorEquals": [
                    "States.ALL"
                  ],
                  "ResultPath": "$.error_deactivate_keys",
                  "Next": "BucketDeny"
                }
              ],
              "Next": "BucketDeny"
            },
            "BucketDeny": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke",
              "Parameters": {
                "FunctionName": "${BucketDenyFnArn}",
                "Payload": {
                  "alert_id.$": "$.alert_id",
                  "principal_arn.$": "$.principal_arn",
                  "user_id.$": "$.user_id",
                  "mode": "${ContainmentMode}",
                  "execution.$": "$$.Execution.Name"
                }
              },
              "ResultSelector": {
                "result.$": "$.Payload"
              },
              "ResultPath": "$.bucket_deny",
              "Retry": [
                {
                  "ErrorEquals": [
                    "Lambda.ServiceException",
                    "Lambda.AWSLambdaException",
                    "Lambda.SdkClientException",
                    "Lambda.TooManyRequestsException"
                  ],
                  "IntervalSeconds": 1,
                  "MaxAttempts": 2,
                  "BackoffRate": 2
                }
              ],
              "Catch": [
                {
                  "ErrorEquals": [
                    "States.ALL"
                  ],
                  "ResultPath": "$.error_bucket_deny",
                  "Next": "DnsBlock"
                }
              ],
              "Next": "DnsBlock"
            },
            "DnsBlock": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke",
              "Parameters": {
                "FunctionName": "${DnsBlockFnArn}",
                "Payload": {
                  "alert_id.$": "$.alert_id",
                  "principal_arn.$": "$.principal_arn",
                  "user_id.$": "$.user_id",
                  "mode": "${ContainmentMode}",
                  "execution.$": "$$.Execution.Name"
                }
              },
              "ResultSelector": {
                "result.$": "$.Payload"
              },
              "ResultPath": "$.dns_block",
              "Retry": [
                {
                  "ErrorEquals": [
                    "Lambda.ServiceException",
                    "Lambda.AWSLambdaException",
                    "Lambda.SdkClientException",
                    "Lambda.TooManyRequestsException"
                  ],
                  "IntervalSeconds": 1,
                  "MaxAttempts": 2,
                  "BackoffRate": 2
                }
              ],
              "Catch": [
                {
                  "ErrorEquals": [
                    "States.ALL"
                  ],
                  "ResultPath": "$.error_dns_block",
                  "Next": "MarkContained"
                }
              ],
              "Next": "MarkContained"
            },
            "MarkContained": {
              "Type": "Task",
              "Resource": "arn:aws:states:::dynamodb:updateItem",
              "Parameters": {
                "TableName": "${AlertsTable}",
                "Key": {
                  "alert_id": {
                    "S.$": "$.alert_id"
                  }
                },
                "UpdateExpression": "SET #s = :new",
                "ConditionExpression": "attribute_exists(alert_id) AND #s IN (:a0)",
                "ExpressionAttributeNames": {
                  "#s": "status"
                },
                "ExpressionAttributeValues": {
                  ":new": {
                    "S": "CONTAINED"
                  },
                  ":a0": {
                    "S": "OPEN"
                  }
                }
              },
              "ResultPath": null,
              "Catch": [
                {
                  "ErrorEquals": [
                    "States.ALL"
                  ],
                  "ResultPath": "$.error_status_contained",
                  "Next": "ContainmentDone"
                }
              ],
              "Next": "AnnounceContained"
            },
            "AnnounceContained": {
              "Type": "Task",
              "Resource": "arn:aws:states:::events:putEvents",
              "Parameters": {
                "Entries": [
                  {
                    "EventBusName": "${BusName}",
                    "Source": "finshield.response",
                    "DetailType": "Incident Updated",
                    "Detail": {
                      "alert_id.$": "$.alert_id",
                      "status": "CONTAINED",
                      "step": "contained"
                    }
                  }
                ]
              },
              "ResultPath": null,
              "Catch": [
                {
                  "ErrorEquals": [
                    "States.ALL"
                  ],
                  "ResultPath": "$.error_announce_contained",
                  "Next": "ContainmentDone"
                }
              ],
              "Next": "ContainmentDone"
            },
            "ContainmentDone": {
              "Type": "Succeed"
            }
          }
        },
        {
          "StartAt": "CritAiExplain",
          "States": {
            "CritAiExplain": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke",
              "Parameters": {
                "FunctionName": "${AiExplainFnArn}",
                "Payload": {
                  "alert_id.$": "$.alert_id",
                  "execution.$": "$$.Execution.Name"
                }
              },
              "ResultSelector": {
                "result.$": "$.Payload"
              },
              "ResultPath": "$.ai",
              "Retry": [
                {
                  "ErrorEquals": [
                    "Lambda.ServiceException",
                    "Lambda.AWSLambdaException",
                    "Lambda.SdkClientException",
                    "Lambda.TooManyRequestsException"
                  ],
                  "IntervalSeconds": 1,
                  "MaxAttempts": 2,
                  "BackoffRate": 2
                }
              ],
              "TimeoutSeconds": 25,
              "Catch": [
                {
                  "ErrorEquals": [
                    "States.ALL"
                  ],
                  "ResultPath": "$.error_ai",
                  "Next": "CritAiFallback"
                }
              ],
              "Next": "AiDone"
            },
            "CritAiFallback": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke",
              "Parameters": {
                "FunctionName": "${AiExplainFnArn}",
                "Payload": {
                  "alert_id.$": "$.alert_id",
                  "force_fallback": true,
                  "execution.$": "$$.Execution.Name"
                }
              },
              "ResultSelector": {
                "result.$": "$.Payload"
              },
              "ResultPath": "$.ai",
              "Retry": [
                {
                  "ErrorEquals": [
                    "Lambda.ServiceException",
                    "Lambda.AWSLambdaException",
                    "Lambda.SdkClientException",
                    "Lambda.TooManyRequestsException"
                  ],
                  "IntervalSeconds": 1,
                  "MaxAttempts": 2,
                  "BackoffRate": 2
                }
              ],
              "Catch": [
                {
                  "ErrorEquals": [
                    "States.ALL"
                  ],
                  "ResultPath": "$.error_ai_fallback",
                  "Next": "AiDone"
                }
              ],
              "Next": "AiDone"
            },
            "AiDone": {
              "Type": "Succeed"
            }
          }
        }
      ],
      "ResultPath": null,
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error_parallel",
          "Next": "InvokeReportsAsync"
        }
      ],
      "Next": "InvokeReportsAsync"
    },
    "InvokeReportsAsync": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${AiReportsFnArn}",
        "InvocationType": "Event",
        "Payload": {
          "alert_id.$": "$.alert_id",
          "execution.$": "$$.Execution.Name"
        }
      },
      "ResultPath": null,
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error_reports",
          "Next": "NotifyCritical"
        }
      ],
      "Next": "NotifyCritical"
    },
    "NotifyCritical": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sns:publish",
      "Parameters": {
        "TopicArn": "${AlertTopicArn}",
        "Subject": "FinShield CRITICAL alert (SAMPLE)",
        "Message.$": "States.Format('Alert {} scored {} (CRITICAL). Containment is in place. Open FinShield to approve the lock-down within 30 minutes.', $.alert_id, $.score)"
      },
      "ResultPath": null,
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error_notify",
          "Next": "MarkAwaitingApproval"
        }
      ],
      "Next": "MarkAwaitingApproval"
    },
    "MarkAwaitingApproval": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Parameters": {
        "TableName": "${AlertsTable}",
        "Key": {
          "alert_id": {
            "S.$": "$.alert_id"
          }
        },
        "UpdateExpression": "SET #s = :new",
        "ConditionExpression": "attribute_exists(alert_id) AND #s IN (:a0, :a1)",
        "ExpressionAttributeNames": {
          "#s": "status"
        },
        "ExpressionAttributeValues": {
          ":new": {
            "S": "AWAITING_APPROVAL"
          },
          ":a0": {
            "S": "OPEN"
          },
          ":a1": {
            "S": "CONTAINED"
          }
        }
      },
      "ResultPath": null,
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error_status_awaiting_approval",
          "Next": "AwaitApproval"
        }
      ],
      "Next": "AnnounceAwaitingApproval"
    },
    "AnnounceAwaitingApproval": {
      "Type": "Task",
      "Resource": "arn:aws:states:::events:putEvents",
      "Parameters": {
        "Entries": [
          {
            "EventBusName": "${BusName}",
            "Source": "finshield.response",
            "DetailType": "Incident Updated",
            "Detail": {
              "alert_id.$": "$.alert_id",
              "status": "AWAITING_APPROVAL",
              "step": "awaitingapproval"
            }
          }
        ]
      },
      "ResultPath": null,
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error_announce_awaitingapproval",
          "Next": "AwaitApproval"
        }
      ],
      "Next": "AwaitApproval"
    },
    "AwaitApproval": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke.waitForTaskToken",
      "TimeoutSeconds": 1800,
      "Parameters": {
        "FunctionName": "${DecisionFnArn}",
        "Payload": {
          "action": "STORE_TOKEN",
          "alert_id.$": "$.alert_id",
          "task_token.$": "$$.Task.Token",
          "execution_arn.$": "$$.Execution.Id",
          "escalated": false
        }
      },
      "ResultPath": "$.approval",
      "Catch": [
        {
          "ErrorEquals": [
            "States.Timeout"
          ],
          "ResultPath": "$.error_approval_timeout",
          "Next": "EscalateToComplianceHead"
        },
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error_approval",
          "Next": "EvidenceClosed"
        }
      ],
      "Next": "DecisionChoice"
    },
    "EscalateToComplianceHead": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sns:publish",
      "Parameters": {
        "TopicArn": "${AlertTopicArn}",
        "Subject": "FinShield ESCALATION to ComplianceHead (SAMPLE)",
        "Message.$": "States.Format('Alert {} had no approval within 30 minutes and is escalated to the Compliance Head.', $.alert_id)"
      },
      "ResultPath": null,
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error_escalate",
          "Next": "EvidenceEscalated"
        }
      ],
      "Next": "EvidenceEscalated"
    },
    "EvidenceEscalated": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${EvidenceFnArn}",
        "Payload": {
          "action": "append",
          "alert_id.$": "$.alert_id",
          "type": "ESCALATED",
          "actor": "incident",
          "execution.$": "$$.Execution.Name",
          "payload": {
            "to": "ComplianceHead",
            "reason": "no decision within 30 minutes"
          }
        }
      },
      "ResultSelector": {
        "result.$": "$.Payload"
      },
      "ResultPath": null,
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error_escalated",
          "Next": "AwaitApprovalEscalated"
        }
      ],
      "Next": "AwaitApprovalEscalated"
    },
    "AwaitApprovalEscalated": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke.waitForTaskToken",
      "TimeoutSeconds": 1800,
      "Parameters": {
        "FunctionName": "${DecisionFnArn}",
        "Payload": {
          "action": "STORE_TOKEN",
          "alert_id.$": "$.alert_id",
          "task_token.$": "$$.Task.Token",
          "execution_arn.$": "$$.Execution.Id",
          "escalated": true
        }
      },
      "ResultPath": "$.approval",
      "Catch": [
        {
          "ErrorEquals": [
            "States.Timeout"
          ],
          "ResultPath": "$.error_approval_timeout",
          "Next": "ApprovalTimedOut"
        },
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error_approval",
          "Next": "EvidenceClosed"
        }
      ],
      "Next": "DecisionChoice"
    },
    "ApprovalTimedOut": {
      "Type": "Pass",
      "Result": {
        "decision": "TIMEOUT"
      },
      "ResultPath": "$.approval",
      "Next": "DecisionChoice"
    },
    "DecisionChoice": {
      "Type": "Choice",
      "Choices": [
        {
          "And": [
            {
              "Variable": "$.approval.decision",
              "IsPresent": true
            },
            {
              "Variable": "$.approval.decision",
              "StringEquals": "APPROVE"
            }
          ],
          "Next": "Quarantine"
        },
        {
          "And": [
            {
              "Variable": "$.approval.decision",
              "IsPresent": true
            },
            {
              "Variable": "$.approval.decision",
              "StringEquals": "REJECT"
            }
          ],
          "Next": "RecordRejection"
        }
      ],
      "Default": "EvidenceClosed"
    },
    "Quarantine": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${QuarantineFnArn}",
        "Payload": {
          "alert_id.$": "$.alert_id",
          "principal_arn.$": "$.principal_arn",
          "user_id.$": "$.user_id",
          "mode": "${ContainmentMode}",
          "execution.$": "$$.Execution.Name"
        }
      },
      "ResultSelector": {
        "result.$": "$.Payload"
      },
      "ResultPath": "$.quarantine",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error_quarantine",
          "Next": "EvidenceClosed"
        }
      ],
      "Next": "EvidenceClosed"
    },
    "RecordRejection": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${EvidenceFnArn}",
        "Payload": {
          "action": "append",
          "alert_id.$": "$.alert_id",
          "type": "DECISION_REJECTED",
          "actor": "incident",
          "execution.$": "$$.Execution.Name",
          "payload": {
            "containment": "kept",
            "decision.$": "$.approval"
          }
        }
      },
      "ResultSelector": {
        "result.$": "$.Payload"
      },
      "ResultPath": null,
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error_decision_rejected",
          "Next": "EvidenceClosed"
        }
      ],
      "Next": "EvidenceClosed"
    },
    "EvidenceClosed": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${EvidenceFnArn}",
        "Payload": {
          "action": "append",
          "alert_id.$": "$.alert_id",
          "type": "CLOSED_STEP",
          "actor": "incident",
          "execution.$": "$$.Execution.Name",
          "payload": {
            "step": "incident workflow finished"
          }
        }
      },
      "ResultSelector": {
        "result.$": "$.Payload"
      },
      "ResultPath": null,
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error_closed_step",
          "Next": "ExportEvidence"
        }
      ],
      "Next": "ExportEvidence"
    },
    "ExportEvidence": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${EvidenceFnArn}",
        "Payload": {
          "action": "export",
          "alert_id.$": "$.alert_id",
          "execution.$": "$$.Execution.Name"
        }
      },
      "ResultSelector": {
        "result.$": "$.Payload"
      },
      "ResultPath": "$.export",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "End": true
    },
    "HighNotify": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sns:publish",
      "Parameters": {
        "TopicArn": "${AlertTopicArn}",
        "Subject": "FinShield HIGH alert (SAMPLE)",
        "Message.$": "States.Format('Alert {} scored {} (HIGH). Open FinShield to review.', $.alert_id, $.score)"
      },
      "ResultPath": null,
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error_notify_high",
          "Next": "HighAiExplain"
        }
      ],
      "Next": "HighAiExplain"
    },
    "HighAiExplain": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${AiExplainFnArn}",
        "Payload": {
          "alert_id.$": "$.alert_id",
          "execution.$": "$$.Execution.Name"
        }
      },
      "ResultSelector": {
        "result.$": "$.Payload"
      },
      "ResultPath": "$.ai",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 2,
          "BackoffRate": 2
