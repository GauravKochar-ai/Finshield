{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://finshield.local/contract/schemas/evidence_entry.schema.json",
  "title": "Evidence entry",
  "type": "object",
  "required": ["alert_id", "seq", "ts", "type", "actor", "payload", "prev_hash", "hash"],
  "additionalProperties": false,
  "properties": {
    "alert_id": { "type": "string" },
    "seq": { "type": "integer", "minimum": 1 },
    "ts": { "type": "string" },
    "type": { "type": "string", "minLength": 1 },
    "actor": { "type": "string" },
    "payload": { "type": "object" },
    "prev_hash": { "type": "string", "minLength": 1 },
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
