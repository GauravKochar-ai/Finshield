# Copy to .env.local. `make env` (scripts/write-env.sh) writes this from the deployed stack.
NEXT_PUBLIC_API_URL=https://<apiId>.execute-api.ap-south-1.amazonaws.com/v1
NEXT_PUBLIC_REGION=ap-south-1
NEXT_PUBLIC_USER_POOL_ID=
NEXT_PUBLIC_USER_POOL_CLIENT_ID=
# true = read contract/fixtures/*.json, no network and no sign-in
NEXT_PUBLIC_USE_MOCKS=true
